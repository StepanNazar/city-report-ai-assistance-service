AI_ASSISTANCE_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/ai_assistance
AI_ASSISTANCE_DATABASE_ECHO=false
AI_ASSISTANCE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AI_ASSISTANCE_KAFKA_CONSUMER_GROUP=ai-assistance-service
AI_ASSISTANCE_KAFKA_ENABLED=true
AI_ASSISTANCE_GEMINI_API_KEY=your_gemini_api_key
AI_ASSISTANCE_GEMINI_MODEL=gemini-1.5-flash
AI_ASSISTANCE_LOG_LEVEL=INFO
